-- 略記（notation）：型紙 := 述語の適用。右辺の λ が束縛変数（docs/language/syntax.md）

def is_lim(a : ℕ → ℝ, α : ℝ) := ∀ε>0. ∃N:ℕ. ∀n≥N. |a(n) - α| < ε
notation a → α (n → ∞) := is_lim((n : ℕ ↦ a), α)
notation a ⟶ α := is_lim(a, α)

-- 束縛変数の文字は自由。a_n は a に縮むので、a ⟶ α と同じもの
thm notation.same :
  a : ℕ → ℝ, α : ℝ, h : a ⟶ α
  ⊢ a_k → α (k → ∞)

h

-- n を含む式が入る
thm notation.shift :
  a : ℕ → ℝ, α : ℝ, h : a_n → α (n → ∞)
  ⊢ a_{m+1} → α (m → ∞)

Fix ε | hε : ε > 0
  Obtain N, hN : h(ε, hε)
  choose N
  Fix n | hn : n ≥ N
    k : n + 1 ≥ N by linarith
    hN(n + 1, k)

-- 入る所の式の中に「(」があっても、型紙の「(」と取り違えない
thm notation.paren :
  a : ℕ → ℝ, f : ℕ → ℝ, α : ℝ, h : a_n → α + f(0) (n → ∞)
  ⊢ a ⟶ α + f(0)

h

-- 束縛変数は周りの変数と別物（∀ と同じ）
thm notation.shadow :
  a : ℕ → ℝ, α : ℝ, n : ℕ, h : a ⟶ α
  ⊢ a_n → α (n → ∞)

h

-- 下に添字の付く演算子の型紙（エディタの \lim・\max の入力欄。意味は notation で付ける）
notation \lim_{n → ∞} a = α := is_lim((n : ℕ ↦ a), α)

thm notation.lim :
  a : ℕ → ℝ, α : ℝ, h : a ⟶ α
  ⊢ \lim_{k → ∞} a_k = α

h

-- 値になる略記：右辺が関数（項の定義）なら値。端の入る所には 1 つのまとまりが入る
def plus(x : ℝ, y : ℝ) : ℝ := x + y
notation x ⊕ y := plus(x, y)

thm notation.value :
  a : ℝ, b : ℝ, c : ℝ
  ⊢ a ⊕ b + c = plus(a, b) + c

refl

def top(f : ℕ → ℝ, m : ℕ) : ℝ := f(m)
notation \max_{i ≤ m} f := top((i : ℕ ↦ f), m)

thm notation.max :
  a : ℕ → ℝ, m : ℕ
  ⊢ \max_{j ≤ m} (a_j + 1) = top((j : ℕ ↦ a_j + 1), m)

refl

-- 上付き：関数に付いたら引数（下が先、上が後）、数に付いたら冪
thm script.two :
  F : ℕ × ℕ → ℝ, i : ℕ, j : ℕ, h : F_{i+1}^j > 0
  ⊢ F(i + 1, j) > 0

h

thm script.seq :
  u : ℕ → ℝ, n : ℕ, h : u^{n+1} > 0
  ⊢ u(n + 1) > 0

h

thm script.power :
  a : ℕ → ℝ, n : ℕ, h : a_n^2 > 0
  ⊢ a(n)^2 > 0

h
