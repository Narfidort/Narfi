-- 原始再帰の定義（rec）

rec sum(a : ℕ → ℝ, n : ℕ) : ℝ
  sum(a, 0) = 0
  sum(a, n + 1) = sum(a, n) + a_n

rec fact(n : ℕ) : ℕ
  fact(0) = 1
  fact(n + 1) = (n + 1) * fact(n)

thm sum2 :
  a : ℕ → ℝ
  ⊢ sum(a, 2) = a_0 + a_1

sum(a, 2)
  = sum(a, 1) + a_1           by sum.succ(a, 1)
  = sum(a, 0) + a_0 + a_1     by sum.succ(a, 0)
  = a_0 + a_1                 by sum.zero(a)

thm fact1 :
  ⊢ fact(1) = 1

fact(1)
  = (0 + 1) * fact(0)   by fact.succ(0)
  = 1                   by fact.zero

