import algebra.matrix

-- 2×3 の行列の成分
thm m23.entry :
  ⊢ [[1, 2, 3], [4, 5, 6]](1, 2) = 6

n10 : ¬(1 = 0) by decide
n20 : ¬(2 = 0) by decide
n21 : ¬(2 = 1) by decide
z1 : matent(1, 1, 2, 0, 0) = 0 by matent.off_row(1, 1, 2, 0, 0, n10)
z2 : matent(2, 1, 2, 0, 1) = 0 by matent.off_row(2, 1, 2, 0, 1, n10)
z3 : matent(3, 1, 2, 0, 2) = 0 by matent.off_row(3, 1, 2, 0, 2, n10)
z4 : matent(4, 1, 2, 1, 0) = 0 by matent.off_col(4, 1, 2, 1, 0, n20)
z5 : matent(5, 1, 2, 1, 1) = 0 by matent.off_col(5, 1, 2, 1, 1, n21)
o6 : matent(6, 1, 2, 1, 2) = 6 by matent.on(6, 1, 2)
linarith
