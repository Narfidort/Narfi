-- 数列の添字：a : ℕ → ℝ なら a_n・a_{n+1}・a_1 は a(n)・a(n+1)・a(1)

def incr(a : Nat -> Real) := forall n:Nat. a_n <= a_{n+1}

thm sub.basic :
  a : Nat -> Real,
  h : forall n:Nat. a_n <= a_{n+1}
  |- a_0 <= a_{0+1}

h(0)

thm sub.chain :
  a : Nat -> Real,
  h : incr(a)
  |- a_1 <= a_{2}

k : a_1 <= a_{1+1} by h(1)
a_1
  <= a_{1+1}   by k
  = a_2        by ring

-- 宣言された名前（N_1）はそのまま名前
thm sub.name :
  N_1 : Nat
  |- N_1 = N_1

refl

-- 絶対値の中のマイナス
axiom abs.neg : x : Real |- | -x| = |x|

-- 命題 by 根拠
thm show.and_swap :
  P : Prop, Q : Prop
  |- P and Q -> Q and P

assume h : P and Q
  Q and P by h.right, h.left

thm show.then :
  P : Prop, Q : Prop, h : P and Q
  |- Q

P by h.left
h.right

-- 数のあとの積（2x・2(a + b)）。2 by … の by は積にならない
thm mul.implicit :
  x : Real, a : Real, b : Real
  |- 2x + 2(a + b) = x * 2 + 2a + 2 b

ring

thm mul.by :
  x : Real, h : x <= 2
  |- x < 3

x
  <= 2 by h
  < 3 by decide
