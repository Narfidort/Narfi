-- def・notation を使った間違った証明。1本も通ってはいけない。

import analysis.limits

-- 別の数列の収束は出てこない
thm wrong.other :
  a : ℕ → ℝ, b : ℕ → ℝ,
  h : a_n → α (n → ∞)
  ⊢ b_n → α (n → ∞)

h


-- 極限値を取り違えている
thm wrong.limit :
  a : ℕ → ℝ,
  h : a_n → α (n → ∞)
  ⊢ a_n → β (n → ∞)

h


-- ε/2 ではなく ε で評価すると和は 2ε になり、通らない
thm wrong.eps :
  a : ℕ → ℝ, b : ℕ → ℝ, c : ℕ → ℝ,
  conv_a : a_n → α (n → ∞),
  conv_b : b_n → β (n → ∞),
  hc : ∀n:ℕ. c(n) = a(n) + b(n)
  ⊢ c_n → α + β (n → ∞)

Fix ε | hε : ε > 0
  Obtain N₁(ε), hN₁ : conv_a(ε, hε)
  Obtain N₂(ε), hN₂ : conv_b(ε, hε)
  let N := max{N₁, N₂}
  choose N
  Fix n | hn : n ≥ N
    |c(n) - (α + β)|
      = |(a(n) + b(n)) - (α + β)|  by EQ2(hc(n), refl)
      ≤ |a(n) - α| + |b(n) - β|    by triangle(a(n) - α, b(n) - β)
      < ε + ε                       by hN₁(ge.max.left(hn)), hN₂(ge.max.right(hn))
      = ε                           by ring


-- 展開での変数の捕獲：上界 n を代入しても、定義の中の束縛変数 n とは別物
def bounded_by(a : ℕ → ℕ, M : ℕ) :⇔ ∀n:ℕ. a(n) ≤ M

thm wrong.capture :
  a : ℕ → ℕ,
  h : bounded_by(a, n)
  ⊢ ∀n:ℕ. a(n) ≤ n

h


-- 和の収束から、各項の収束は出てこない
thm wrong.split :
  a : ℕ → ℝ, b : ℕ → ℝ, c : ℕ → ℝ,
  hc : ∀n:ℕ. c(n) = a(n) + b(n),
  h : c_n → α + β (n → ∞)
  ⊢ a_n → α (n → ∞)

h


-- 定義されていない名前は根拠に使えない
thm wrong.unfold :
  a : ℕ → ℝ,
  h : a_n → α (n → ∞)
  ⊢ a_n → α (n → ∞)

k : foo(a) by h
h


-- 集合を返す定義を開いても、和集合の要素が片方の要素になるわけではない
def cupx(A : ℝ → Prop, B : ℝ → Prop) : ℝ → Prop := {x : ℝ | x ∈ A ∨ x ∈ B}

thm wrong.union :
  A : ℝ → Prop, B : ℝ → Prop, x : ℝ, h : x ∈ cupx(A, B)
  ⊢ x ∈ A

h


-- 開いた中身の変数を取り違えない（{x | x ∈ A} の x と、外の y）
def onlyx(A : ℝ → Prop, y : ℝ) : ℝ → Prop := {x : ℝ | x ∈ A ∧ x = y}

thm wrong.capture.set :
  A : ℝ → Prop, x : ℝ, y : ℝ, h : x ∈ onlyx(A, y)
  ⊢ x = x + 1

h.right
