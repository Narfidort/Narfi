-- def・notation・import：極限の加法性を a_n → α (n → ∞) の記法で書く
--
-- 数列の和は a_n + b_n と書ける（記法の右辺の λ が n を束縛する）

import analysis.limits


thm conv.add :
  a : ℕ → ℝ, b : ℕ → ℝ,
  conv_a : a_n → α (n → ∞),
  conv_b : b_n → β (n → ∞)
  ⊢ a_n + b_n → α + β (n → ∞)

Fix ε | hε : ε > 0
  Obtain N₁(ε) | hN₁ by conv_a(ε/2, pos_half(hε))
  Obtain N₂(ε) | hN₂ by conv_b(ε/2, pos_half(hε))
  let N := max{N₁, N₂}
  choose N
  Fix n | hn : n ≥ N
    |(a(n) + b(n)) - (α + β)|
      ≤ |a(n) - α| + |b(n) - β|   by triangle(a(n) - α, b(n) - β)
      < ε/2 + ε/2                  by hN₁(ge.max.left(hn)), hN₂(ge.max.right(hn))
      = ε                          by ring
  ∴ ∀n≥N. |(a(n) + b(n)) - (α + β)| < ε


-- 定理として使うときは記法のまま単一化される（関数の穴に λ が入る）
thm conv.add3 :
  a : ℕ → ℝ, b : ℕ → ℝ, c : ℕ → ℝ,
  ha : a_n → α (n → ∞), hb : b_n → β (n → ∞), hc : c_n → γ (n → ∞)
  ⊢ (a_n + b_n) + c_n → (α + β) + γ (n → ∞)

conv.add(conv.add(ha, hb), hc)



-- 明示的に展開する：unfold と定義の同値 is_lim.def
thm conv.unfold :
  a : ℕ → ℝ,
  h : a_n → α (n → ∞)
  ⊢ ∀ε>0. ∃N:ℕ. ∀n≥N. |a(n) - α| < ε

h


thm conv.fold :
  a : ℕ → ℝ,
  h : ∀ε:ℝ>0. ∃N:ℕ. ∀n≥N. |a(n) - α| < ε
  ⊢ a_n → α (n → ∞)

is_lim.def.right(h)
