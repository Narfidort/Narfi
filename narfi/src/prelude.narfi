-- Narfi の組み込み公理（仕様書 §2）。検査器の起動時に最初に読み込まれる。

axiom EQ1 : ∀x. x = x

axiom PA1 : ∀n:ℕ. S(n) ≠ 0
axiom PA2 : ∀m:ℕ. ∀n:ℕ. S(m) = S(n) → m = n

axiom add.zero : ∀n:ℕ. n + 0 = n
axiom add.succ : ∀n:ℕ. ∀m:ℕ. n + S(m) = S(n + m)

axiom mul.zero : ∀n:ℕ. n · 0 = 0
axiom mul.succ : ∀n:ℕ. ∀m:ℕ. n · S(m) = n · m + n


-- 等号の基本補題（EQ1・EQ2 から導出。起動時に検査される）

thm eq.symm :
  h : x = y
  ⊢ y = x

EQ2(h, refl)


thm eq.trans :
  hxy : x = y, hyz : y = z
  ⊢ x = z

EQ2(hyz, hxy)


thm congr.S :
  h : x = y
  ⊢ S(x) = S(y)

EQ2(h, refl)


-- 自然数は 0 以上（項に使えるように定理にしておく）
thm nat.nonneg :
  ⊢ ∀n:ℕ. n ≥ 0

Fix n
  linarith


-- 単純型理論（HOL）の公理：外延性と選択（仕様 §8）

-- 関数は、すべての点で値が等しければ等しい
axiom funext : ∀f. ∀g. (∀x. f(x) = g(x)) → f = g

-- 命題は、互いに導けるなら等しい
axiom propext : ∀P:Prop. ∀Q:Prop. (P → Q) → (Q → P) → P = Q

-- 集合（述語）は、同じ元を持てば等しい
axiom setext : ∀A. ∀B. (∀x. A(x) → B(x)) → (∀x. B(x) → A(x)) → A = B

-- 選択：P を満たすものがあれば、some(P) は P を満たす（Hilbert の ε）
axiom choice : ∀P. (∃x. P(x)) → P(some(P))


-- 集合が等しければ、一方の元は他方の元（等号による書き換え）
thm set.eq_sub :
  h : A = B
  ⊢ ∀x. A(x) → B(x)

Fix x
  assume hx
    EQ2(h, hx)
