  n21 : ¬(2 = 1) by decide
  d21 : delta(2, 1) = 0 by delta.diff(2, 1, n21)
  d22 : delta(2, 2) = 1 by delta.same(2)
  mat3(a00, a01, a02, a10, a11, a12, a20, a21, a22)(2, 2)
    = a00 * delta(2, 0) * delta(2, 0) + a01 * delta(2, 0) * delta(2, 1) + a02 * delta(2, 0) * delta(2, 2) + a10 * delta(2, 1) * delta(2, 0) + a11 * delta(2, 1) * delta(2, 1) + a12 * delta(2, 1) * delta(2, 2) + a20 * delta(2, 2) * delta(2, 0) + a21 * delta(2, 2) * delta(2, 1) + a22 * delta(2, 2) * delta(2, 2)   by refl
    = a00 * 0 * 0 + a01 * 0 * delta(2, 1) + a02 * 0 * delta(2, 2) + a10 * delta(2, 1) * 0 + a11 * delta(2, 1) * delta(2, 1) + a12 * delta(2, 1) * delta(2, 2) + a20 * delta(2, 2) * 0 + a21 * delta(2, 2) * delta(2, 1) + a22 * delta(2, 2) * delta(2, 2)   by EQ2(d20, refl)
    = a00 * 0 * 0 + a01 * 0 * 0 + a02 * 0 * delta(2, 2) + a10 * 0 * 0 + a11 * 0 * 0 + a12 * 0 * delta(2, 2) + a20 * delta(2, 2) * 0 + a21 * delta(2, 2) * 0 + a22 * delta(2, 2) * delta(2, 2)   by EQ2(d21, refl)
    = a00 * 0 * 0 + a01 * 0 * 0 + a02 * 0 * 1 + a10 * 0 * 0 + a11 * 0 * 0 + a12 * 0 * 1 + a20 * 1 * 0 + a21 * 1 * 0 + a22 * 1 * 1   by EQ2(d22, refl)
    = a22   by ring

-- 2×2 の行列式・トレース（成分を書いた行列で）
thm mat2.det :
  ⊢ ∀a:ℝ. ∀b:ℝ. ∀c:ℝ. ∀d:ℝ. det2([[a, b], [c, d]]) = a * d - b * c

Fix a, b, c, d
  e00 : [[a, b], [c, d]](0, 0) = a by mat2.e00(a, b, c, d)
  e01 : [[a, b], [c, d]](0, 1) = b by mat2.e01(a, b, c, d)
  e10 : [[a, b], [c, d]](1, 0) = c by mat2.e10(a, b, c, d)
  e11 : [[a, b], [c, d]](1, 1) = d by mat2.e11(a, b, c, d)
  det2([[a, b], [c, d]])
    = [[a, b], [c, d]](0, 0) * [[a, b], [c, d]](1, 1) - [[a, b], [c, d]](0, 1) * [[a, b], [c, d]](1, 0)   by refl
    = a * [[a, b], [c, d]](1, 1) - [[a, b], [c, d]](0, 1) * [[a, b], [c, d]](1, 0)   by EQ2(e00, refl)
    = a * d - [[a, b], [c, d]](0, 1) * [[a, b], [c, d]](1, 0)   by EQ2(e11, refl)
    = a * d - b * [[a, b], [c, d]](1, 0)   by EQ2(e01, refl)
    = a * d - b * c   by EQ2(e10, refl)

thm mat2.tr :
  ⊢ ∀a:ℝ. ∀b:ℝ. ∀c:ℝ. ∀d:ℝ. mtr([[a, b], [c, d]], 2) = a + d

Fix a, b, c, d
  t : mtr([[a, b], [c, d]], 2) = [[a, b], [c, d]](0, 0) + [[a, b], [c, d]](1, 1) by mtr.two([[a, b], [c, d]])
  e00 : [[a, b], [c, d]](0, 0) = a by mat2.e00(a, b, c, d)
  e11 : [[a, b], [c, d]](1, 1) = d by mat2.e11(a, b, c, d)
  linarith
