-- 排中律・自然数の場合分け・クロネッカーのデルタ（行列・線形代数で使う基本）

import algebra.sum

-- 排中律（古典論理）
thm em :
  P : Prop
  ⊢ P ∨ ¬P

by_contra h
  np : ¬P
    assume p : P
      h(or.left(p))
  h(or.right(np))

-- 自然数は 0 か、ある m の次
thm nat.cases :
  ⊢ ∀n:ℕ. n = 0 ∨ (∃m:ℕ. n = S(m))

Fix n
  induction n
    Case zero
      left
      refl
    Case succ k, IH : k = 0 ∨ (∃m:ℕ. k = S(m))
      right
      choose k
      refl

-- 2 より小さい自然数は 0 か 1
thm nat.lt2 :
  ⊢ ∀n:ℕ. n < 2 ⇒ n = 0 ∨ n = 1

Fix n | h : n < 2
  c : n = 0 ∨ (∃m:ℕ. n = S(m)) by nat.cases(n)
  cases c
    Case left z
      left
      z
    Case right e
      Obtain m | hm by e
      d : m = 0 ∨ (∃p:ℕ. m = S(p)) by nat.cases(m)
      cases d
        Case left mz
          right
          n
            = S(m)   by hm
            = S(0)   by EQ2(mz, refl)
            = 1      by ring
        Case right f
          Obtain p | hp by f
          q : p ≥ 0 by nat.nonneg(p)
          r : n = S(S(p)) by EQ2(hp, hm)
          right
          linarith

-- クロネッカーのデルタ δ(i, j)：i = j なら 1、そうでなければ 0
def isdelta(i : ℕ, j : ℕ, x : ℝ) :⇔ (i = j ∧ x = 1) ∨ (¬(i = j) ∧ x = 0)
def delta(i : ℕ, j : ℕ) : ℝ := some({x : ℝ | isdelta(i, j, x)})

thm delta.exists :
  ⊢ ∀i:ℕ. ∀j:ℕ. ∃x:ℝ. isdelta(i, j, x)

Fix i, j
  c : i = j ∨ ¬(i = j) by em
  cases c
    Case left e
      choose 1
      left
      e, refl
    Case right ne
      choose 0
      right
      ne, refl

thm delta.spec :
  ⊢ ∀i:ℕ. ∀j:ℕ. isdelta(i, j, delta(i, j))

Fix i, j
  choice({x : ℝ | isdelta(i, j, x)}, delta.exists(i, j))

thm delta.same :
  ⊢ ∀i:ℕ. delta(i, i) = 1

Fix i
  s : isdelta(i, i, delta(i, i)) by delta.spec(i, i)
  cases s
    Case left a
      a.right
    Case right b
      e : i = i by refl
      bot.elim(b.left(e))

thm delta.diff :
  ⊢ ∀i:ℕ. ∀j:ℕ. ¬(i = j) ⇒ delta(i, j) = 0

Fix i, j
  assume ne : ¬(i = j)
    s : isdelta(i, j, delta(i, j)) by delta.spec(i, j)
    cases s
      Case left a
        bot.elim(ne(a.left))
      Case right b
        b.right

-- ---------------------------------------------------------------- δ を掛けた和（添字を 1 つ選ぶ）

-- Σ_{j<m} δ(k, j) u_j = u_k（k < m のとき）
thm dsum.pick :
  u : ℕ → ℝ
  ⊢ ∀m:ℕ. ∀k:ℕ. k < m ⇒ sum((j : ℕ ↦ delta(k, j) * u_j), m) = u_k

Fix m, k
  assume hk : k < m
    hz : ∀j:ℕ. j < m ⇒ j ≠ k ⇒ delta(k, j) * u_j = 0
      Fix j
        assume hj : j < m
          assume hne : j ≠ k
            nk : k ≠ j
              assume e : k = j
                hne(eq.symm(e))
            dz : delta(k, j) = 0 by delta.diff(k, j, nk)
            delta(k, j) * u_j
              = 0 * u_j   by dz
              = 0         by ring
    le : m ≤ m by linarith
    sg : (k < m ⇒ sum((j : ℕ ↦ delta(k, j) * u_j), m) = delta(k, k) * u_k) ∧ (¬(k < m) ⇒ sum((j : ℕ ↦ delta(k, j) * u_j), m) = 0) by sum.single(hz)(m, le)
    dk : delta(k, k) = 1 by delta.same(k)
    sum((j : ℕ ↦ delta(k, j) * u_j), m)
      = delta(k, k) * u_k   by sg.left(hk)
      = 1 * u_k             by dk
      = u_k                 by ring

-- 範囲の外の k では 0
thm dsum.out :
  u : ℕ → ℝ
  ⊢ ∀m:ℕ. ∀k:ℕ. ¬(k < m) ⇒ sum((j : ℕ ↦ delta(k, j) * u_j), m) = 0

Fix m, k
  assume nk : ¬(k < m)
    kge : m ≤ k by nat.not_lt(nk)
    hz : ∀j:ℕ. j < m ⇒ delta(k, j) * u_j = 0
      Fix j
        assume hj : j < m
          ne : k ≠ j
            assume e : k = j
              linarith
          dz : delta(k, j) = 0 by delta.diff(k, j, ne)
          delta(k, j) * u_j
            = 0 * u_j   by dz
            = 0         by ring
    sum((j : ℕ ↦ delta(k, j) * u_j), m)
      = sum((j : ℕ ↦ 0), m)   by sum.cong(m, hz)
      = 0                     by sum.zeros(m)

-- δ は同じ数を足しても変わらない
thm delta.shift :
  ⊢ ∀a:ℕ. ∀b:ℕ. ∀c:ℕ. delta(c + a, c + b) = delta(a, b)

Fix a, b, c
  e0 : a = b ∨ ¬(a = b) by em
  cases e0
    Case left e
      d1 : delta(c + a, c + a) = 1 by delta.same(c + a)
      d2 : delta(a, a) = 1 by delta.same(a)
      delta(c + a, c + b)
        = delta(c + a, c + a)   by e
        = 1                     by d1
        = delta(a, a)           by eq.symm(d2)
        = delta(a, b)           by e
    Case right ne
      ne2 : ¬(c + a = c + b)
        assume e : c + a = c + b
          q : a = b by linarith
          ne(q)
      d1 : delta(c + a, c + b) = 0 by delta.diff(c + a, c + b, ne2)
      d2 : delta(a, b) = 0 by delta.diff(a, b, ne)
      delta(c + a, c + b)
        = 0           by d1
        = delta(a, b) by eq.symm(d2)

-- 後ろにずらした添字でも選べる：Σ_{j<m} δ(c + j₀, c + j) u_j = u_{j₀}
thm dsum.shift :
  u : ℕ → ℝ
  ⊢ ∀c:ℕ. ∀m:ℕ. ∀j0:ℕ. j0 < m ⇒ sum((j : ℕ ↦ delta(c + j0, c + j) * u_j), m) = u_{j0}

Fix c, m, j0
  assume hj : j0 < m
    h1 : ∀j:ℕ. j < m ⇒ delta(c + j0, c + j) * u_j = delta(j0, j) * u_j
      Fix j
        assume hj2 : j < m
          ds : delta(c + j0, c + j) = delta(j0, j) by delta.shift(j0, j, c)
          delta(c + j0, c + j) * u_j
            = delta(j0, j) * u_j   by ds
    sum((j : ℕ ↦ delta(c + j0, c + j) * u_j), m)
      = sum((j : ℕ ↦ delta(j0, j) * u_j), m)   by sum.cong(m, h1)
      = u_{j0}                                 by dsum.pick(m, j0, hj)

-- 前半の範囲の k では、ずらした和は 0
thm dsum.below :
  u : ℕ → ℝ
  ⊢ ∀c:ℕ. ∀m:ℕ. ∀k:ℕ. k < c ⇒ sum((j : ℕ ↦ delta(k, c + j) * u_j), m) = 0

Fix c, m, k
  assume hk : k < c
    hz : ∀j:ℕ. j < m ⇒ delta(k, c + j) * u_j = 0
      Fix j
        assume hj : j < m
          ne : k ≠ c + j
            assume e : k = c + j
              linarith
          dz : delta(k, c + j) = 0 by delta.diff(k, c + j, ne)
          delta(k, c + j) * u_j
            = 0 * u_j   by dz
            = 0         by ring
    sum((j : ℕ ↦ delta(k, c + j) * u_j), m)
      = sum((j : ℕ ↦ 0), m)   by sum.cong(m, hz)
      = 0                     by sum.zeros(m)
