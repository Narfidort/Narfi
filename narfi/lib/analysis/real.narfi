-- 実数の基本的な不等式（公理として置く。v2 では「利用者の公理」として報告される）

axiom triangle     : ∀x:ℝ. ∀y:ℝ. |x + y| ≤ |x| + |y|
axiom pos_half     : x : ℝ, h : x > 0 ⊢ x/2 > 0
axiom ge.max.left  : n : ℕ, h : n ≥ max{a, b} ⊢ n ≥ a
axiom ge.max.right : n : ℕ, h : n ≥ max{a, b} ⊢ n ≥ b

-- アルキメデス性：どんな実数よりも大きい自然数がある（自然数は実数に埋め込まれる）
axiom archimedes   : x : ℝ ⊢ ∃N:ℕ. N > x

-- 逆数の大小
axiom inv.pos      : x : ℝ, h : x > 0 ⊢ 1/x > 0
axiom inv.lt       : x : ℝ, e : ℝ, hx : x > 0, he : e > 0, h : x > 1/e ⊢ 1/x < e

-- 正の数の絶対値
axiom abs.of_pos   : x : ℝ, h : x > 0 ⊢ |x| = x
