-- 三角形の添字：対 (j, l)、j < l の個数 tr(d) = d(d − 1)/2 と、和の平方の展開

import linear.span

-- tr(L) = 0 + 1 + … + (L − 1)
rec tr(L : ℕ) : ℕ
  tr(0) = 0
  tr(L + 1) = tr(L) + L

-- 2 tr(L) + L = L²
thm tr.double :
  ⊢ ∀L:ℕ. 2 * tr(L) + L = L * L

Fix L
  induction L
    Case zero
      t0 : tr(0) = 0 by tr.zero
      2 * tr(0) + 0
        = 2 * 0 + 0   by t0
        = 0 * 0       by ring
    Case succ k, IH : 2 * tr(k) + k = k * k
      s : S(k) = k + 1 by ring
      ts : tr(k + 1) = tr(k) + k by tr.succ(k)
      2 * tr(S(k)) + S(k)
        = 2 * tr(k + 1) + (k + 1)        by s
        = 2 * (tr(k) + k) + (k + 1)      by ts
        = (2 * tr(k) + k) + (2 * k + 1)  by ring
        = k * k + (2 * k + 1)            by IH
        = (k + 1) * (k + 1)              by ring
        = S(k) * S(k)                    by EQ2(eq.symm(s), refl)

-- (Σ y_j)² = Σ y_j² + Σ_{l} Σ_{j<l} 2 y_j y_l
thm sq.sum :
  y : ℕ → ℝ
  ⊢ ∀D:ℕ. sum(y, D) * sum(y, D) = sum((j : ℕ ↦ y_j * y_j), D) + sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), D)

Fix D
  induction D
    Case zero
      z1 : sum(y, 0) = 0 by sum.zero(y)
      z2 : sum((j : ℕ ↦ y_j * y_j), 0) = 0 by sum.zero((j : ℕ ↦ y_j * y_j))
      z3 : sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), 0) = 0 by sum.zero((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)))
      sum(y, 0) * sum(y, 0)
        = 0 * 0                                                                                   by z1
        = 0 + 0                                                                                   by ring
        = sum((j : ℕ ↦ y_j * y_j), 0) + sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), 0)       by z2, z3
    Case succ k, IH : sum(y, k) * sum(y, k) = sum((j : ℕ ↦ y_j * y_j), k) + sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k)
      s : S(k) = k + 1 by ring
      q1 : sum(y, k + 1) = sum(y, k) + y_k by sum.succ(y, k)
      q2 : sum((j : ℕ ↦ y_j * y_j), k + 1) = sum((j : ℕ ↦ y_j * y_j), k) + y_k * y_k by sum.succ((j : ℕ ↦ y_j * y_j), k)
      q3 : sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k + 1) = sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k) + sum((j : ℕ ↦ 2 * (y_j * y_k)), k) by sum.succ((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k)
      h4 : ∀j:ℕ. j < k ⇒ 2 * (y_j * y_k) = (2 * y_k) * y_j
        Fix j
          assume hj : j < k
            ring
      q4 : sum((j : ℕ ↦ 2 * (y_j * y_k)), k) = sum((j : ℕ ↦ (2 * y_k) * y_j), k) by sum.cong(k, h4)
      q5 : sum((j : ℕ ↦ (2 * y_k) * y_j), k) = (2 * y_k) * sum(y, k) by sum.smul(2 * y_k, y, k)
      sum(y, S(k)) * sum(y, S(k))
        = sum(y, k + 1) * sum(y, k + 1)                                                  by s
        = (sum(y, k) + y_k) * (sum(y, k) + y_k)                                          by q1
        = sum(y, k) * sum(y, k) + y_k * y_k + (2 * y_k) * sum(y, k)                      by ring
        = sum((j : ℕ ↦ y_j * y_j), k) + sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k) + y_k * y_k + (2 * y_k) * sum(y, k)   by IH
        = sum((j : ℕ ↦ y_j * y_j), k) + y_k * y_k + (sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k) + (2 * y_k) * sum(y, k))   by ring
        = sum((j : ℕ ↦ y_j * y_j), k + 1) + (sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k) + (2 * y_k) * sum(y, k))   by q2
        = sum((j : ℕ ↦ y_j * y_j), k + 1) + (sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k) + sum((j : ℕ ↦ (2 * y_k) * y_j), k))   by q5
        = sum((j : ℕ ↦ y_j * y_j), k + 1) + (sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k) + sum((j : ℕ ↦ 2 * (y_j * y_k)), k))   by q4
        = sum((j : ℕ ↦ y_j * y_j), k + 1) + sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), k + 1)   by q3
        = sum((j : ℕ ↦ y_j * y_j), S(k)) + sum((l : ℕ ↦ sum((j : ℕ ↦ 2 * (y_j * y_l)), l)), S(k))   by EQ2(eq.symm(s), refl)

-- 三角形に並んだ関数 q(l, j)（j < l < D）の 1 次結合の族は、tr(D) 個の関数で張られる空間に入る
thm cdim.tri :
  q : ℕ × ℕ → (ℕ → ℝ) → ℝ, W : ℕ × ℕ × ℕ → ℝ, N : ℕ
  ⊢ ∀D:ℕ. cdim((i : ℕ ↦ (x : ℕ → ℝ ↦ sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D))), N, tr(D))

Fix D
  induction D
    Case zero
      t0 : tr(0) = 0 by tr.zero
      choose (k : ℕ ↦ (x : ℕ → ℝ ↦ 0))
      choose ((i, k) : ℕ × ℕ ↦ 0)
      Fix i
        assume hi : i ≤ N
          Fix x
            sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), 0)
              = 0                                          by sum.zero((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)))
              = sum((k : ℕ ↦ 0 * 0), 0)                    by EQ2(eq.symm(sum.zero((k : ℕ ↦ 0 * 0))), refl)
              = sum((k : ℕ ↦ 0 * 0), tr(0))                by EQ2(t0, refl)
    Case succ D1, IH : cdim((i : ℕ ↦ (x : ℕ → ℝ ↦ sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D1))), N, tr(D1))
      s : S(D1) = D1 + 1 by ring
      ts : tr(D1 + 1) = tr(D1) + D1 by tr.succ(D1)
      row : cdim((i : ℕ ↦ (x : ℕ → ℝ ↦ sum((j : ℕ ↦ W(i, D1, j) * q(D1, j)(x)), D1))), N, D1)
        choose (j : ℕ ↦ (x : ℕ → ℝ ↦ q(D1, j)(x)))
        choose ((i, j) : ℕ × ℕ ↦ W(i, D1, j))
        Fix i
          assume hi : i ≤ N
            Fix x
              refl
      h1 : cdim((i : ℕ ↦ (x : ℕ → ℝ ↦ sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D1) + sum((j : ℕ ↦ W(i, D1, j) * q(D1, j)(x)), D1))), N, tr(D1) + D1) by cdim.add(IH, row)
      hq : ∀i:ℕ. i ≤ N ⇒ ∀x:ℕ → ℝ. sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), S(D1)) = sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D1) + sum((j : ℕ ↦ W(i, D1, j) * q(D1, j)(x)), D1)
        Fix i
          assume hi : i ≤ N
            Fix x
              sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), S(D1))
                = sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D1 + 1)   by s
                = sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D1) + sum((j : ℕ ↦ W(i, D1, j) * q(D1, j)(x)), D1)   by sum.succ((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), D1)
      h2 : cdim((i : ℕ ↦ (x : ℕ → ℝ ↦ sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), S(D1)))), N, tr(D1) + D1) by cdim.cong(h1, hq)
      ts2 : tr(S(D1)) = tr(D1) + D1
        tr(S(D1))
          = tr(D1 + 1)    by s
          = tr(D1) + D1   by ts
      fin : cdim((i : ℕ ↦ (x : ℕ → ℝ ↦ sum((l : ℕ ↦ sum((j : ℕ ↦ W(i, l, j) * q(l, j)(x)), l)), S(D1)))), N, tr(S(D1))) by cdim.resize(h2, eq.symm(ts2))
      fin
